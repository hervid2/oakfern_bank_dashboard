# ---------------------------------------------------------------------------
# Oakfern .gitignore (AC-000-13). No secret, credential or .env file is ever
# tracked; .env.example is the single committed, placeholder-only exception.
# ---------------------------------------------------------------------------

# Environment / secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/
build/
dist/
next-env.d.ts

# Generated Prisma client (regenerated by `prisma generate` / postinstall)
src/generated/

# TypeScript incremental build info
*.tsbuildinfo

# Test, coverage and tooling output
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/
.playwright-mcp/

# Vercel
.vercel/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
*.swp
