# ---------------------------------------------------------------------------
# Oakfern environment template. Copy to `.env.local` and fill in real values.
# PLACEHOLDERS ONLY — never commit a real connection string or secret here.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the running application (pooled URL in
# a deployed environment). Local development uses the Docker Compose service
# created in feature 000, which publishes host port 5433 -> container 5432.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/DATABASE?schema=public"

# Optional. Direct / unpooled connection string, used only by the Prisma CLI
# (`migrate dev`, `migrate deploy`, `migrate status`). Required for Neon,
# whose pooled host (`-pooler`) cannot run migrations. Leave empty locally:
# `prisma.config.ts` falls back to DATABASE_URL.
DIRECT_DATABASE_URL=""

# Session signing secret for the HS256 JWT (ADR-0004). Minimum 32 characters.
# There is no default: the app fails loudly when it is missing (AC-001-19).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Optional, local and CI only. Set to "1" to expose the two deliberate-failure
# probes (`/_dev/boom`, `/_dev/shell-boom`) in a production build so the error
# boundaries can be verified end to end (AC-001-16, AC-001-24). Never set it in
# a deployed environment: without it both routes answer 404.
OAKFERN_ENABLE_DEV_ROUTES=""
